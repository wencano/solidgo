package templates

templ Layout(title string, pageScript string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8">
			<meta name="viewport" content="width=device-width, initial-scale=1.0">
			<title>{ title }</title>
			<link rel="stylesheet" href={ GetCSSPath() }>
			<script type="module" src="/static/js/notifications-dropdown.js"></script>
			<script type="module" src={ pageScript }></script>
		</head>
		<body>
			<nav class="bg-white shadow-sm border-b border-gray-200 sticky top-0 z-40">
				<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
					<div class="flex items-center justify-between h-16">
						<div class="flex items-center gap-6">
							<a href="/" class="text-2xl font-bold text-gray-900 hover:text-gray-700 transition-colors">
								SolidGo
							</a>
							<a href="/entities" class="text-sm font-medium text-gray-700 hover:text-gray-900 transition-colors">Entities</a>
							<nav class="hidden md:flex gap-4">
								<a href="/" class="text-sm font-medium text-gray-700 hover:text-gray-900 transition-colors">Dashboard</a>
							</nav>
						</div>
						<div class="flex items-center gap-4">
							<div class="relative" id="notifications-container">
								<button
									id="notifications-button"
									class="relative p-2 text-gray-500 hover:text-gray-700 hover:bg-gray-100 rounded-full transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2"
									aria-label="Notifications"
								>
									<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
									</svg>
									<span id="notifications-badge" class="hidden absolute top-1 right-1 block h-5 w-5 rounded-full bg-red-500 text-white text-xs font-semibold flex items-center justify-center border-2 border-white"></span>
								</button>
								<div id="notifications-dropdown"></div>
							</div>
						</div>
					</div>
				</div>
			</nav>
			@children
		</body>
	</html>
}

